import re
print("Введите текст сообщения:")
a = input()
print("Введите запрещенные слова (через запятую):")
b = input()
e, f = re.subn(r"\b(" + b.replace(",", "|") + r")\b", "СКРЫТО", a, flags=re.I)
print("Обнаружено замен:", f)
print("Исходное сообщение:", a)
print("Отфильтрованное сообщение:", e)
